@using System.Drawing;
@model string

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Manipulation</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            display: flex;
            align-items: flex-start;
            width: 80%;
        }

        .image-column {
            flex: 1;
            padding: 20px;
        }

        #image-container {
            max-width: 100%;
        }

        #image {
            max-width: 100%;
        }

        .controls-column {
            flex: 1;
            padding: 20px;
            background-color: #f0f0f0;
            border-left: 1px solid #ddd;
        }

        .controls {
            text-align: center;
        }

        input[type="file"] {
            margin-bottom: 10px;
        }

        input[type="range"] {
            width: 80%;
            margin-bottom: 10px;
        }

        button {
            padding: 10px 20px;
            background-color: #007BFF;
            color: #fff;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>Image Manipulation</h1>
    <div class="container">
        <div class="image-column">
            <div id="image-container">
                <img id="image" src="data:image/jpeg;base64,@(Model)" alt="Uploaded Image">
            </div>
        </div>
        <div class="controls-column">
            <div class="controls">
                <form action="@Url.Action("Index", "Home")" method="post" enctype="multipart/form-data">
                    <input type="file" id="file-input" name="img">
                    <input type="submit" value="Upload" id="uploadsubmit" action="">
                </form>

                <label for="red-gamma">Red Gamma:</label>
                <input type="range" id="red-gamma" min="0.1" max="3" step="0.1" value="1">
                <label for="green-gamma">Green Gamma:</label>
                <input type="range" id="green-gamma" min="0.1" max="3" step="0.1" value="1">
                <label for="blue-gamma">Blue Gamma:</label>
                <input type="range" id="blue-gamma" min="0.1" max="3" step="0.1" value="1">



                <label>
                    <input type="checkbox" id="invertColors"> Invert Colors
                </label>
                <label>
                    <input type="checkbox" id="grayscale"> Grayscale
                </label>
                <label>
                    <input type="checkbox" id="applyGamma"> Apply Gamma Correction
                </label>

                
            </div>
        </div>
    </div>

    <script>
        const uploadedImage = document.getElementById('image');
        const invertColorsCheckbox = document.getElementById('invertColors');
        const grayscaleCheckbox = document.getElementById('grayscale');
        const applyGammaCheckbox = document.getElementById('applyGamma');
        const fileInput = document.getElementById('file-input');

        invertColorsCheckbox.addEventListener('change', function () {
            if (this.checked) {
                url = '@Url.Action("Invert", "Home")';
                uploadedImage.src = url;
            } else {
                // Clear any transformations
                //uploadedImage.src = '';
            }
        });
        grayscaleCheckbox.addEventListener('change', function () {
            if (this.checked) {
                url = '@Url.Action("Grayscale", "Home")';
                uploadedImage.src = url;
            } else {
                // Clear any transformations
                //uploadedImage.src = '';
            }
        });
        applyGammaCheckbox.addEventListener('change', function () {
            if (this.checked) {
                url = '@Url.Action("GetActualImage", "Home")';
                uploadedImage.src = url;
            } else {
                // Clear any transformations
                //uploadedImage.src = '';
            }
        });


        document.getElementById('file-input').addEventListener('change', function (e) {
            const fileInput = e.target;

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    uploadedImage.src = e.target.result;
                };

                reader.readAsDataURL(fileInput.files[0]);
            } else {

                //uploadedImage.src = ''; // Clear the image if no file is selected
            }
        });</script>
</body>
</html>
