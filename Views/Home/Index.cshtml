@using System.Drawing;
@model string

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Manipulation</title>
    <style>
        body {
            font-family: Arial, sans-serif;
/*            display: flex;*/
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            display: flex;
            align-items: flex-start;
            width: 100%;
        }

        .image-column {
            flex: 2;
            padding: 20px;
        }

        #image-container {
            max-width: 100%;
        }

        #image {
            max-width: 100%;
        }

        .controls-column {
            flex: 1;
            padding: 20px;
            background-color: #f0f0f0;
            border-left: 1px solid #ddd;
        }

        .controls {
            text-align: center;
        }

        input[type="file"] {
            margin-bottom: 10px;
        }

        input[type="range"] {
            width: 70%;
            margin-bottom: 10px;
        }

        button {
            padding: 10px 20px;
            background-color: #007BFF;
            color: #fff;
            border: none;
            cursor: pointer;
        }
        h1 {
            display: block;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div><h1>Image Manipulation</h1></div>
    

    <div class="container">
        <div class="image-column">
            <div id="image-container">
                <img id="image" src="data:image/jpeg;base64,@(Model)" alt="Uploaded Image">
            </div>
        </div>
        <div class="controls-column">
            <div class="controls">
                <form action="@Url.Action("Index", "Home")" method="post" enctype="multipart/form-data">
                    <input type="file" id="file-input" name="img">
                    <input type="submit" value="Upload" id="uploadsubmit" action="">
                </form>

                <button id="undo">Undo</button>
                <br>
                <button id="invertColors">Invert Colors</button>
                <br>x
                <button id="grayscale">Grayscale</button>
                <br>

                <button id="btnbrightness">Apply Brightness</button>
                <br>
                <input type="range" id="brightness" min="-255" max="255" step="1" value="0"><span id="brightness-value">0</span>
                <br>
                <button id="btncontrast">Apply Contrast</button>
                <br>
                <input type="range" id="contrast" min="-100" max="100" step="1" value="0"><span id="contrast-value">0</span>
                <br>
                <button id="applyGamma">Apply Gamma Correction</button>
                <br>
                <label for="red-gamma">Red Gamma:</label>
                <input type="range" id="red-gamma" min="-255" max="255" step="1" value="0"><span id="red-range-value">0</span>
                <br>
                <label for="green-gamma">Green Gamma:</label>
                <input type="range" id="green-gamma" min="-255" max="255" step="1" value="0"><span id="green-range-value">0</span>
                <br>
                <label for="blue-gamma">Blue Gamma:</label>
                <input type="range" id="blue-gamma" min="-255" max="255" step="1" value="0"><span id="blue-range-value">0</span>
                <br>



            </div>
        </div>
    </div>

    <script>
        const btnsubmit = document.getElementById('uploadsubmit');
        const uploadedImage = document.getElementById('image');
        const invertColorsCheckbox = document.getElementById('invertColors');
        const grayscaleCheckbox = document.getElementById('grayscale');
        const btnbrightness = document.getElementById('btnbrightness');
        const btncontrast = document.getElementById('btncontrast');
        const applyGammaCheckbox = document.getElementById('applyGamma');
        const fileInput = document.getElementById('file-input');

        const brightnessRange = document.getElementById('brightness');
        const contrastRange = document.getElementById('contrast');

        const redgamma = document.getElementById('red-gamma');
        const greengamma = document.getElementById('green-gamma');
        const bluegamma = document.getElementById('blue-gamma');

        const brightnessvalue = document.getElementById('brightness-value');
        const contrastvalue = document.getElementById('contrast-value');

        const redRangeValue = document.getElementById('red-range-value');
        const greenRangeValue = document.getElementById('green-range-value');
        const blueRangeValue = document.getElementById('blue-range-value');

        const btnundo = document.getElementById('undo');

        brightnessRange.addEventListener('input', function () {
            brightnessvalue.textContent = this.value;
        });
        contrastRange.addEventListener('input', function () {
            contrastvalue.textContent = this.value;
        });

        redgamma.addEventListener('input', function () {
            redRangeValue.textContent = this.value;
        });
        greengamma.addEventListener('input', function () {
            greenRangeValue.textContent = this.value;
        });
        bluegamma.addEventListener('input', function () {
            blueRangeValue.textContent = this.value;
        });



        invertColorsCheckbox.addEventListener('click', function () {
            url = '@Url.Action("Invert", "Home")';
            uploadedImage.src = url;
            if (this.checked) {

            } else {
                // Clear any transformations
                //uploadedImage.src = '';
            }
        });
        grayscaleCheckbox.addEventListener('click', function () {
            url = '@Url.Action("Grayscale", "Home")';
                uploadedImage.src = url;
            if (this.checked) {

            } else {
                // Clear any transformations
                //uploadedImage.src = '';
            }
        });
        btnbrightness.addEventListener('click', function () {
            url = '@Url.Action("Brightness", "Home", new { brightness = "PLACEHOLDER_BRIGHTNESS" })';
            url = url.replace("PLACEHOLDER_BRIGHTNESS", parseInt(brightnessvalue.textContent))
            console.log(url)
            uploadedImage.src = url;
        });
        btncontrast.addEventListener('click', function () {
            url = '@Url.Action("Contrast", "Home", new { contrast = "PLACEHOLDER_CONTRAST" })';
            url = url.replace("PLACEHOLDER_CONTRAST", parseInt(contrastvalue.textContent))
            console.log(url)
            uploadedImage.src = url;
        });


        applyGammaCheckbox.addEventListener('click', function () {
            url = '@Url.Action("Gamma", "Home", new {
                      red = "PLACEHOLDER_RED",
                      green = "PLACEHOLDER_GREEN",
                      blue = "PLACEHOLDER_BLUE",
                })';

                url = url
                    .replace("PLACEHOLDER_RED", parseInt(redRangeValue.textContent))
                    .replace("PLACEHOLDER_GREEN", parseInt(greenRangeValue.textContent))
                    .replace("PLACEHOLDER_BLUE", parseInt(blueRangeValue.textContent));
                console.log(url)
                uploadedImage.src = url;
            if (this.checked) {

            } else {
                // Clear any transformations
                //uploadedImage.src = '';
            }
        });

        btnundo.addEventListener('click',  function () {
            uploadedImage.src = '';
            console.log('undo')
            url = '@Url.Action("Undo", "Home")';
            uploadedImage.src = url;
        });

        document.getElementById('file-input').addEventListener('change', function (e) {
            const fileInput = e.target;

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    uploadedImage.src = e.target.result;
                };

                reader.readAsDataURL(fileInput.files[0]);
            }
            //else {

            //    //uploadedImage.src = ''; // Clear the image if no file is selected
            //}
        });</script>
</body>
</html>
